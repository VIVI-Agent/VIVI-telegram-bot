datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum SpeedEnum {
    AUTO
    FAST
    TURBO
}

enum WhitelistType {
    DAOSWORLD
    OTHER
    STABLE
}

model GlobalConfig {
    id                   Int     @id @default(1)
    referralBonusPercent Float   @default(50)
    enableGroupBot       Boolean @default(false)
    enabledPresale       Boolean @default(false)
}

model Subscriber {
    id               Int      @id @default(autoincrement())
    email            String   @unique
    tgUserId         BigInt   @unique
    tgUsername       String   @unique
    subscriptionDate DateTime @default(now())
    waitlistPosition Int
    hasAccess        Boolean  @default(false)
}

model AdminUser {
    id       Int    @id @default(autoincrement())
    username String @unique
    password String
}

model User {
    id           Int            @id @default(autoincrement())
    tgUserId     String?        @unique
    tgUsername   String?        @unique
    isPending    Boolean        @default(false)
    createdAt    DateTime       @default(now())
    speed        SpeedEnum      @default(AUTO)
    wallets      Wallet[]
    buySettings  BuySettings?
    sellSettings SellSettings?
    holdings     Holding[]
    trades       Trade[]
    Withdrawal   Withdrawal[]
    UserFeedback UserFeedback[]
    pnlCache     PnlCache[]

    points         Decimal @default(0.0) @db.Decimal(28, 18)
    referralPoints Decimal @default(0.0) @db.Decimal(28, 18)

    totalVolumeBoughtWei Decimal @default(0) @db.Decimal(78, 0)
    totalVolumeSoldWei   Decimal @default(0) @db.Decimal(78, 0)

    referredById Int?
    referredBy   User?  @relation("UserReferrals", fields: [referredById], references: [id])
    referrals    User[] @relation("UserReferrals")

    presaleWallet    String?
    BuyEventPurchase BuyEventPurchase[]

    rewardWallet String?
}

model Wallet {
    id               Int                @id @default(autoincrement())
    address          String             @unique
    encryptedPrivKey String
    createdAt        DateTime           @default(now())
    userId           Int
    user             User               @relation(fields: [userId], references: [id])
    isSelected       Boolean            @default(false)
    balance          String
    trades           Trade[]
    holdings         Holding[]
    Allowance        Allowance[]
    Permit2Allowance Permit2Allowance[]
    Withdrawal       Withdrawal[]
    BuyEventPurchase BuyEventPurchase[]
    isDeleted        Boolean            @default(false)
    deletedAt        DateTime?          @default(now())
}

model BuySettings {
    id       Int   @id @default(autoincrement())
    userId   Int   @unique
    user     User  @relation(fields: [userId], references: [id])
    amount1  Float
    amount2  Float
    amount3  Float
    amount4  Float
    amount5  Float
    slippage Float

    lastAmount   Float?
    lastSlippage Float?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model SellSettings {
    id       Int   @id @default(autoincrement())
    userId   Int   @unique
    user     User  @relation(fields: [userId], references: [id])
    amount1  Float
    amount2  Float
    amount3  Float
    slippage Float

    lastAmount   Float?
    lastSlippage Float?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Token {
    id                Int                @id @default(autoincrement())
    address           String             @unique
    name              String
    symbol            String
    decimals          Int
    holdings          Holding[]
    trades            Trade[]
    Allowance         Allowance[]
    Permit2Allowance  Permit2Allowance[]
    Withdrawal        Withdrawal[]
    ExternalTokenInfo ExternalTokenInfo?
    ExternalPoolInfo  ExternalPoolInfo[]
    BuyEvent          BuyEvent[]
}

model ExternalTokenInfo {
    id      Int   @id @default(autoincrement())
    tokenId Int   @unique
    token   Token @relation(fields: [tokenId], references: [id])

    website      String?
    telegramLink String?
    twitterLink  String?

    totalHolders Int?
    totalSupply  String?

    isHoneypot        String?
    isMintable        String?
    isPotentiallyScam String?

    marketCapUsd   Decimal? @db.Decimal(38, 18)
    fullyDilutedMc Decimal? @db.Decimal(38, 18)

    lastUpdated DateTime @default(now())
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model ExternalPoolInfo {
    id           Int      @id @default(autoincrement())
    address      String   @unique
    tokenId      Int?
    token        Token?   @relation(fields: [tokenId], references: [id])
    dexName      String?
    feeTier      Int?
    liquidityUsd String?
    volume24hUsd String?
    priceUsd     String?
    lastUpdated  DateTime @default(now())
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
}

model Holding {
    id                Int       @id @default(autoincrement())
    userId            Int
    user              User      @relation(fields: [userId], references: [id])
    tokenId           Int
    token             Token     @relation(fields: [tokenId], references: [id])
    walletId          Int
    wallet            Wallet    @relation(fields: [walletId], references: [id])
    balance           String
    totalCostBasis    String    @default("0") // Total ETH spent (in wei)
    totalTokensBought String    @default("0") // Total tokens acquired
    realizedPnlWei    String    @default("0") // Realized profit/loss in wei
    pnlCache          PnlCache?
    updatedAt         DateTime  @updatedAt
}

model Trade {
    id        Int      @id @default(autoincrement())
    userId    Int
    user      User     @relation(fields: [userId], references: [id])
    tokenId   Int
    token     Token    @relation(fields: [tokenId], references: [id])
    walletId  Int
    wallet    Wallet   @relation(fields: [walletId], references: [id])
    type      String
    timestamp DateTime @default(now())
    txId      String

    ethSpent       String?
    ethReceived    String?
    tokensSpent    String?
    tokensReceived String?
}

model Allowance {
    id        Int      @id @default(autoincrement())
    walletId  Int
    wallet    Wallet   @relation(fields: [walletId], references: [id])
    tokenId   Int
    token     Token    @relation(fields: [tokenId], references: [id])
    spender   String
    allowance String
    updatedAt DateTime @updatedAt
}

model Permit2Allowance {
    id             Int      @id @default(autoincrement())
    walletId       Int
    wallet         Wallet   @relation(fields: [walletId], references: [id])
    tokenId        Int
    token          Token    @relation(fields: [tokenId], references: [id])
    spender        String // Dirección del contrato que puede gastar (ej: VIVIUniswapV4)
    amount         String // Cantidad aprobada (string para BigInt, usamos máximo)
    expiration     String // Timestamp de expiración (string para BigInt, usamos máximo)
    permit2Address String // Dirección del contrato Permit2
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@unique([walletId, tokenId, spender, permit2Address])
    @@index([walletId])
    @@index([tokenId])
    @@index([spender])
}

model Withdrawal {
    id        Int      @id @default(autoincrement())
    userId    Int
    user      User     @relation(fields: [userId], references: [id])
    walletId  Int
    wallet    Wallet   @relation(fields: [walletId], references: [id])
    tokenId   Int?
    token     Token?   @relation(fields: [tokenId], references: [id])
    amount    String
    txHash    String
    toAddress String
    timestamp DateTime @default(now())
}

model UserFeedback {
    id        Int      @id @default(autoincrement())
    userId    Int
    user      User     @relation(fields: [userId], references: [id])
    feedback  String
    imageUrls String[]
    createdAt DateTime @default(now())
}

model FeeWhitelist {
    id                 Int           @id @default(autoincrement())
    address            String        @unique
    feeBps             Int
    bonusPointsPercent Float         @default(0)
    type               WhitelistType @default(OTHER)
    createdAt          DateTime      @default(now())
    updatedAt          DateTime      @default(now())
}

model DexScreenerProfile {
    id           Int     @id @default(autoincrement())
    chainId      String
    tokenAddress String
    url          String
    icon         String?
    header       String?
    description  String?
    links        String? // JSON string con la lista de links

    // Indice/unique por chainId + tokenAddress
    @@unique([chainId, tokenAddress])
}

model ChannelOrGroup {
    id                   Int      @id @default(autoincrement())
    chatId               String   @unique // El ID del grupo/canal en Telegram (e.g. -1001234567890)
    isGroup              Boolean  @default(false) // true => group/supergroup, false => canal
    notificationsEnabled Boolean  @default(false) // si están activadas las notificaciones
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt
}

// EVENTS Models

model BuyEvent {
    id             Int             @id @default(autoincrement())
    name           String
    bannerImageUrl String
    tokenId        Int
    token          Token           @relation(fields: [tokenId], references: [id])
    createdBy      BigInt // Admin User ID que creó el evento
    groupChatId    String
    group          AuthorizedGroup @relation(fields: [groupChatId], references: [chatId])

    startedAt DateTime  @default(now())
    closedAt  DateTime?

    isActive  Boolean            @default(true)
    purchases BuyEventPurchase[]

    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
    BuyEventResult BuyEventResult?

    @@index([groupChatId]) // Índice para acelerar consultas por grupo
}

model BuyEventPurchase {
    id      Int      @id @default(autoincrement())
    eventId Int
    event   BuyEvent @relation(fields: [eventId], references: [id])

    userId Int
    user   User @relation(fields: [userId], references: [id])

    walletId Int
    wallet   Wallet @relation(fields: [walletId], references: [id])

    txHash            String  @unique
    ethSpentWei       Decimal @db.Decimal(78, 0) // Guardamos monto en wei
    tokensReceivedWei Decimal @db.Decimal(78, 0) // Tokens recibidos en wei

    createdAt DateTime @default(now())
}

model AuthorizedGroup {
    id          Int     @id @default(autoincrement())
    chatId      String  @unique
    description String?

    buyEvents BuyEvent[] // relación inversa útil para consulta rápida

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model BuyEventResult {
    id      Int      @id @default(autoincrement())
    eventId Int      @unique
    event   BuyEvent @relation(fields: [eventId], references: [id])

    leaderboardSnapshot Json
    biggestBuyUserId    Int?
    biggestBuyAmountWei Decimal? @db.Decimal(78, 0) // En Wei
    mostPurchasesUserId Int?
    totalVolumeWei      Decimal  @db.Decimal(78, 0) // En Wei

    createdAt DateTime @default(now())
}

model PnlCache {
    id        Int      @id @default(autoincrement())
    userId    Int
    user      User     @relation(fields: [userId], references: [id])
    holdingId Int?     @unique // null = user summary, not null = specific holding
    holding   Holding? @relation(fields: [holdingId], references: [id])

    // Cached PnL data
    currentValueWei  String // Current value in wei
    currentPriceWei  String // Current price per token in wei
    costBasisWei     String // Cost basis in wei
    unrealizedPnlWei String // Unrealized PnL in wei
    realizedPnlWei   String // Realized PnL in wei
    totalPnlWei      String // Total PnL in wei
    percentageReturn String // Percentage return as string (e.g., "15.88")

    // Metadata
    isStale             Boolean  @default(false) // true if needs refresh
    lastCalculatedAt    DateTime @default(now())
    lastBlockchainCheck DateTime @default(now())

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
    @@index([userId, holdingId])
    @@index([isStale])
}

model BankrCache {
    id Int @id @default(autoincrement())

    // Cache key components
    username String // The username being searched
    platform String // "twitter" or "farcaster"

    // Cached response data
    accountId     String // Bankr account ID
    evmAddress    String // EVM address
    solanaAddress String // Solana address
    bankrClub     Boolean // Bankr Club status

    // Cache metadata
    lastAccessed DateTime @default(now()) // Last time this entry was accessed

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Composite unique index on username + platform (case insensitive)
    @@unique([username, platform])
    @@index([username])
    @@index([platform])
    @@index([lastAccessed])
}

// ===== MODELOS DEL BOT SECUNDARIO (KOL BOT) =====

model KolUser {
    id         Int      @id @default(autoincrement())
    telegramId BigInt   @unique // Telegram user ID
    username   String? // Telegram username
    firstName  String? // Telegram first name
    lastName   String? // Telegram last name
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    // Relación con grupos donde es owner
    ownedGroups KolGroup[] @relation("KolGroupOwner")

    @@map("kol_users")
}

model KolGroup {
    id         Int      @id @default(autoincrement())
    telegramId BigInt   @unique // Telegram group/channel ID
    title      String // Group title
    username   String? // Group username
    type       String // "group", "supergroup", "channel"
    ownerId    Int // ID del usuario owner
    owner      KolUser  @relation("KolGroupOwner", fields: [ownerId], references: [id])
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    // Configuración del grupo
    settings KolGroupSettings?

    @@map("kol_groups")
}

model KolGroupSettings {
    id      Int      @id @default(autoincrement())
    groupId Int      @unique
    group   KolGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

    // Configuración del bot
    isEnabledForOwner Boolean @default(false) // Si el bot responde al owner de la group (disabled by default)
    isEnabledForUsers Boolean @default(false) // Si el bot responde a todos los usuarios de la group (disabled by default)
    walletAddress     String? // Dirección de wallet para recibir rewards (solo owner puede configurar)
    amount1           String  @default("0.02") // Monto del botón 1
    amount2           String  @default("0.04") // Monto del botón 2
    amount3           String  @default("0.07") // Monto del botón 3
    amount4           String  @default("0.1") // Monto del botón 4

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("kol_group_settings")
}

model KolBotSession {
    id        Int      @id @default(autoincrement())
    sessionId String   @unique // ID único de la sesión
    userId    Int // ID del usuario
    groupId   Int? // ID del grupo (opcional, para sesiones de configuración)
    data      Json // Datos de la sesión
    expiresAt DateTime // Cuándo expira la sesión
    createdAt DateTime @default(now())

    @@map("kol_bot_sessions")
}

model TradeInstruction {
    id           String  @id @default(uuid())
    tokenAddress String
    tokenName    String?
    tokenSymbol  String?
    amount       String

    // Usuario original (para referrals)
    originalTgUserId String

    // Información del grupo
    groupId    String
    groupTitle String?

    // TTL para limpiar registros viejos
    expiresAt DateTime
    createdAt DateTime @default(now())

    @@index([id])
    @@index([expiresAt])
    @@map("trade_instructions")
}
