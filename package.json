{
  "name": "vivi-telegram-bot",
  "version": "0.7.3",
  "main": "index.js",
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "dev:bot": "NODE_ENV=development ts-node-dev -r tsconfig-paths/register --respawn --transpile-only --log-error src/bot/bot.ts",
    "dev:server": "NODE_ENV=development ts-node-dev -r tsconfig-paths/register --respawn --transpile-only --log-error src/_server/server.ts",
    "build": "tsc && tsc-alias",
    "prebuild": "npx prisma migrate deploy",
    "prisma:deploy": "npx prisma migrate deploy",
    "start:bot": "NODE_ENV=production node dist/bot/bot.js",
    "start:server": "NODE_ENV=production node dist/server/server.js",
    "script:broadcast": "npx ts-node src/_scripts/batchMessages/broadcast.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@telegraf/session": "^2.0.0-beta.7",
    "@types/lodash.clonedeep": "^4.5.9",
    "axios": "^1.8.4",
    "axios-retry": "^4.5.0",
    "bcrypt": "^5.1.1",
    "bottleneck": "^2.19.5",
    "cors": "^2.8.5",
    "datadog-winston": "^1.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lodash.clonedeep": "^4.5.0",
    "morgan": "^1.10.0",
    "pg": "^8.14.1",
    "redis": "^4.7.0",
    "sharp": "^0.33.5",
    "telegraf": "^4.16.3",
    "viem": "2.30.0",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@telegraf/types": "^8.3.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/datadog-winston": "^1.0.7",
    "@types/express": "^5.0.1",
    "@types/express-rate-limit": "^6.0.2",
    "@types/helmet": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/lodash": "^4.17.16",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.11",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.11",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  },
  "volta": {
    "node": "18.20.2"
  }
}
